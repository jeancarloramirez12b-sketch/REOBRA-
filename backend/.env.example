# Puerto HTTP del servidor Express.
PORT=3001

# Entorno: development, test o production.
NODE_ENV=development

# Origen exacto del frontend permitido por CORS.
# Debe coincidir con la URL desde la que se abre la interfaz.
FRONTEND_ORIGIN=http://localhost:5173

# MySQL. Estos valores son ilustrativos.
# Cree backend/.env con sus datos locales y no lo versione.
# DB_PASSWORD puede quedar vacío solo si el usuario local no tiene clave.
DB_HOST=localhost
DB_PORT=3306
DB_USER=reobra_user
DB_PASSWORD=cambiar_esta_clave
DB_NAME=reobra

# Sesiones: no hay SESSION_SECRET. El token es aleatorio y MySQL guarda solo su hash.
# Secure se activa con NODE_ENV=production. La sesión dura 12 horas y rota a las 6.

# Asistente. Sin estas variables el servicio responde que no está configurado.
# No pongas una clave real en el repositorio ni en variables de Vite.
# AI_ENABLED=true
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_MS=20000
# AI_MAX_INPUT_CHARS=2000
# AI_MAX_OUTPUT_TOKENS=800
# AI_USER_HOURLY_LIMIT=30
# AI_ORG_HOURLY_LIMIT=200
